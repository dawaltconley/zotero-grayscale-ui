{
  "name": "zotero-grayscale-ui",
  "type": "module",
  "version": "0.1.0",
  "description": "Zotero plugin providing various grayscale UI options.",
  "config": {
    "addonName": "Grayscale UI",
    "addonID": "grayscale-ui@dylan.ac",
    "addonRef": "grayscale-ui",
    "addonInstance": "GrayscaleUI",
    "prefsPrefix": "extensions.zotero.grayscale-ui"
  },
  "scripts": {
    "dev": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "Dylan Awalt-Conley",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^8.57.1",
    "@types/node": "^22.20.1",
    "esbuild-sass-plugin": "^3.7.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^7.18.0",
    "zotero-plugin-scaffold": "^0.6.1",
    "zotero-types": "^4.1.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dawaltconley/zotero-grayscale-ui.git"
  },
  "keywords": [
    "zotero",
    "plugin"
  ],
  "bugs": {
    "url": "https://github.com/dawaltconley/zotero-grayscale-ui/issues"
  },
  "homepage": "https://github.com/dawaltconley/zotero-grayscale-ui#readme",
  "prettier": {
    "printWidth": 80,
    "singleQuote": true,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
